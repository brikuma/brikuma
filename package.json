{
  "name": "brikuma-project-tooling",
  "version": "0.1.0",
  "private": true,
  "description": "Independent root documentation and Git quality tooling; no application runtime",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "prepare": "husky",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:integration": "node scripts/docs-check.mjs --mode=pinned --tree=HEAD --scope=all",
    "docs:test": "node --test scripts/docs-check.test.mjs",
    "format:check": "prettier --check .",
    "staged:check": "lint-staged --concurrent false",
    "quality:test": "node --test scripts/quality.test.mjs",
    "hooks:check": "node --test scripts/hooks.test.mjs",
    "deps:audit": "npm audit --audit-level=high",
    "check:prepare": "node scripts/quality.mjs prepare",
    "review:record": "node scripts/quality.mjs record-review",
    "review:check": "node scripts/quality.mjs review",
    "check:commit": "node scripts/quality.mjs commit",
    "check:push": "node scripts/quality.mjs push",
    "check": "npm run docs:check && npm run format:check && npm run docs:test && npm run quality:test && npm run hooks:check"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9"
  }
}
